<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Wicked.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wicked.Tests" />
    <InternalsVisibleTo Include="wickedd" />
  </ItemGroup>

  <!-- The signed catalog is also built in, as the offline fallback (D8). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\catalog.json" LogicalName="catalog.json" />
    <EmbeddedResource Include="..\..\catalog\catalog.json.sig" LogicalName="catalog.json.sig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="$(SqliteVersion)" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SqlitePclVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wicked.Contracts\Wicked.Contracts.csproj" />
  </ItemGroup>

</Project>
