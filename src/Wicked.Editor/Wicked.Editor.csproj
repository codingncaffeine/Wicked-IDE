<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Wicked.Editor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wicked.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TextMateSharp" Version="$(TextMateSharpVersion)" />
    <PackageReference Include="TextMateSharp.Grammars" Version="$(TextMateSharpVersion)" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp" Version="$(HarfBuzzSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- JetBrains Mono 2.304 (SIL Open Font License 1.1, Fonts/JetBrainsMono-OFL.txt): the editor's default font. -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Wicked.Editor.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wicked.Core\Wicked.Core.csproj" />
  </ItemGroup>

</Project>
