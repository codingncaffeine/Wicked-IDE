<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Wicked.App.Shell"
        xmlns:chat="using:Wicked.App.Chat">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Ground}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <!-- A panel's heading: small, spaced capitals, as the reference editors set them. -->
  <Style Selector="TextBlock.heading">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <!-- The floating panels: rounded cards on the ground with a soft shadow. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Panel}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Panel}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.panel.editor">
    <Setter Property="Background" Value="{DynamicResource Brush.Editor}" />
  </Style>

  <!-- Quiet buttons: the rail, the title bar's toggles and every toolbar. -->
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Pressed}" />
  </Style>
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The rail's buttons: the open panel's button is lit. -->
  <Style Selector="Button.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.rail.active">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.rail.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>

  <!-- Caption buttons, drawn because the window draws its own title bar. -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="30" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Caption.Close}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- The command centre in the title bar: a search field look, a button underneath. -->
  <Style Selector="Button.command-centre">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.command-centre:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,18,0" />
  </Style>

  <!-- A key cap in hints: "Ctrl+Shift+P". -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <!-- The splitters between panels are the gaps themselves: invisible until the pointer finds them. -->
  <Style Selector="GridSplitter.gap">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="6" />
  </Style>
  <Style Selector="GridSplitter.gap:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>

  <!-- Tabs: the strip sits on the panel colour; the active tab takes the editor's colour so it joins the text below. -->
  <Style Selector="Border.tabstrip">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="Border.tab">
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="Border.tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="Border.tab.active">
    <Setter Property="Background" Value="{DynamicResource Brush.Editor}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Border.tab TextBlock.preview">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="Ellipse.dirty">
    <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The close button shows on the active or hovered tab; on a dirty tab it replaces the dot only under the pointer. -->
  <Style Selector="Button.tabclose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="Border.tab.active Button.tabclose, Border.tab:pointerover Button.tabclose">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.tab Button.tabclose.dirty">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.tab Button.tabclose.dirty:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Pressed}" />
  </Style>
  <Style Selector="GridSplitter.groupgap">
    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    <Setter Property="MinWidth" Value="1" />
  </Style>

  <!-- A quiet accent button: the explorer's Open Folder. -->
  <Style Selector="Button.accent-soft">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <!-- The explorer: compact rows, the selection in the accent wash. -->
  <Style Selector="TreeView.explorer TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
  </Style>
  <Style Selector="TreeView.explorer TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>
  <Style Selector="TreeView.explorer TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>
  <Style Selector="TreeView.explorer TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="TreeView.explorer TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- The palette: a floating card under the title bar. -->
  <Style Selector="Border.quickinput">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="BoxShadow" Value="0 12 40 0 #99000000" />
  </Style>
  <Style Selector="TextBox.quickinput">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="ListBox.quickinput">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.quickinput ListBoxItem">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="ListBox.quickinput ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>

  <!-- The save prompt -->
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22,20" />
    <Setter Property="BoxShadow" Value="0 16 48 0 #A6000000" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="14,7" />
  </Style>

  <!-- The Models panel -->
  <Style Selector="Border.machine">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.pick">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.pick:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
  </Style>
  <Style Selector="Border.role">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.role > TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}" />
  </Style>

  <!-- The find widget: a floating card at the editor's top right. -->
  <Style Selector="Border.findwidget">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #80000000" />
  </Style>
  <Style Selector="TextBox.find">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="6,3,80,3" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="TextBox.find.error">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="ToggleButton.findopt">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="ToggleButton.findopt:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style Selector="Grid.settings > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <!-- Breadcrumbs under the tabs, and the welcome page's recent folders. -->
  <Style Selector="Border.breadcrumbs">
    <Setter Property="Padding" Value="14,4" />
    <Setter Property="Background" Value="{DynamicResource Brush.Editor}" />
  </Style>
  <Style Selector="TextBlock.crumb">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.crumb-last">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="shell|Icon.crumbsep">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="Margin" Value="2,0" />
  </Style>
  <Style Selector="Button.recent">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Hover}" />
  </Style>
  <Style Selector="Button.recent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>

  <!-- A link-looking button: the licence page, a model's page. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="14,7" />
  </Style>

  <!-- Browse models: model rows, fit badges, the tabs, the role chips and the Hugging Face result list. -->
  <Style Selector="Border.modelrow">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.modelrow:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
  </Style>
  <Style Selector="Border.fit">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Border.fit Ellipse">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="Border.fit TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="Border.fit.ok Ellipse">
    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
  </Style>
  <Style Selector="Border.fit.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
  </Style>
  <Style Selector="Border.fit.offload Ellipse">
    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="Border.fit.offload TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="14,6" />
  </Style>
  <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Button.segment.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="ListBox.results">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.results ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.results ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>

  <Style Selector="Border.alert">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <!-- ── The chat ── -->
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Small}" />
  </Style>
  <Style Selector="Button.secondary.small, Button.primary.small">
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Button.chipbutton">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.chipbutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Pressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Button.menurow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Button.menurow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Ellipse.state">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
  </Style>
  <Style Selector="Ellipse.state.loaded">
    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
  </Style>
  <Style Selector="Ellipse.state.loading">
    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="Ellipse.state.failed">
    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="TextBox.composer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement, TextBox.composer:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ProgressBar.high">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="Border.message">
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Border.message.user">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.reasoning">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="8,0,0,0" />
  </Style>
  <Style Selector="chat|MarkdownView.reasoningtext TextBlock, chat|MarkdownView.reasoningtext SelectableTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>
  <Style Selector="Border.replyerror">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.codeblock">
    <Setter Property="Background" Value="{DynamicResource Brush.Editor}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Grid.codehead">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="Grid.codehead Button">
    <Setter Property="Margin" Value="0,2,2,2" />
  </Style>
  <Style Selector="Border.quotebar">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="10,0,0,0" />
  </Style>
  <Style Selector="Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Margin" Value="0,6" />
  </Style>
  <Style Selector="Border.taskbox">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Margin" Value="0,3,0,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.mdhead">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="9,5" />
  </Style>
  <Style Selector="Border.mdcell">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="9,5" />
  </Style>
  <Style Selector="Grid.historyrow">
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Grid.historyrow.current Button.historyopen">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
  </Style>
  <Style Selector="Button.historyopen">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Button.historyopen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="shell|Icon">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
</Styles>
