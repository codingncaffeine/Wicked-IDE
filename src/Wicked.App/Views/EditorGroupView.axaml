<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wb="using:Wicked.App.Workbench"
             xmlns:shell="using:Wicked.App.Shell"
             xmlns:views="using:Wicked.App.Views"
             x:Class="Wicked.App.Views.EditorGroupView"
             x:DataType="wb:EditorGroup">
  <DockPanel>
    <!-- The tab strip -->
    <Border DockPanel.Dock="Top" Classes="tabstrip" IsVisible="{Binding Tabs.Count}">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <ItemsControl Name="TabStrip" ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="wb:EditorTab">
              <Border Classes="tab" Classes.active="{Binding IsActive}" ToolTip.Tip="{Binding Tooltip}" Tag="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <shell:Icon Data="{StaticResource Icon.FileCode}" Size="14" />
                  <TextBlock Text="{Binding Title}" Classes.preview="{Binding IsPreview}" VerticalAlignment="Center" />
                  <Panel Width="18" Height="18">
                    <Ellipse Classes="dirty" Width="8" Height="8" IsVisible="{Binding IsDirty}" />
                    <Button Classes="tabclose" Classes.dirty="{Binding IsDirty}" Tag="{Binding}" Click="OnClose" ToolTip.Tip="Close (Ctrl+W)">
                      <shell:Icon Data="{StaticResource Icon.X}" Size="12" StrokeWidth="2" />
                    </Button>
                  </Panel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Breadcrumbs: where the file is in the folder. -->
    <Border DockPanel.Dock="Top" Classes="breadcrumbs" Name="Crumbs" IsVisible="False">
      <ItemsControl Name="CrumbList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>

    <Panel>
      <ContentControl Name="Host" />
      <views:FindWidget Name="FindBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,22,0" IsVisible="False" />
      <!-- An empty group shows the welcome. -->
      <StackPanel Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460">
        <Image Source="/Assets/logo.png" Width="96" Height="96" HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="Wicked" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
        <TextBlock Classes="secondary" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Local models that stay up to date, and a real editor around them." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,14,0,0">
          <Button Name="WelcomeNewProject" Classes="primary" Click="OnWelcomeNewProject" Padding="14,6" ToolTip.Tip="A new project from a template (Ctrl+Shift+N)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <shell:Icon Data="{StaticResource Icon.FolderPlus}" Size="15" />
              <TextBlock Text="New Project…" />
            </StackPanel>
          </Button>
          <Button Name="WelcomeOpenFolder" Classes="secondary" Click="OnWelcomeOpenFolder" Padding="14,6" ToolTip.Tip="Open a folder (Ctrl+K Ctrl+O)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <shell:Icon Data="{StaticResource Icon.FolderOpen}" Size="15" />
              <TextBlock Text="Open Folder…" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,18,0,0" Width="300" RowSpacing="8">
          <TextBlock Classes="secondary" Text="Show all commands" VerticalAlignment="Center" />
          <Border Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+Shift+P" /></Border>
          <TextBlock Grid.Row="1" Classes="secondary" Text="Go to file" VerticalAlignment="Center" />
          <Border Grid.Row="1" Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+P" /></Border>
          <TextBlock Grid.Row="2" Classes="secondary" Text="Open folder" VerticalAlignment="Center" />
          <Border Grid.Row="2" Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+K Ctrl+O" /></Border>
          <TextBlock Grid.Row="3" Classes="secondary" Text="Show or hide the side bar" VerticalAlignment="Center" />
          <Border Grid.Row="3" Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+B" /></Border>
          <TextBlock Grid.Row="4" Classes="secondary" Text="Show or hide the assistant" VerticalAlignment="Center" />
          <Border Grid.Row="4" Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+L" /></Border>
        </Grid>
        <Button Name="WelcomeGetStarted" Classes="link" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnWelcomeGetStarted"
                ToolTip.Tip="The first things to do in Wicked (Help: Get Started)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <shell:Icon Data="{StaticResource Icon.ListChecks}" Size="14" />
            <TextBlock Text="Get started with Wicked" />
          </StackPanel>
        </Button>
        <StackPanel Name="Recent" Spacing="4" Margin="0,18,0,0" Width="300">
          <TextBlock Classes="heading" Text="RECENT" />
          <ItemsControl Name="RecentList" />
        </StackPanel>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
