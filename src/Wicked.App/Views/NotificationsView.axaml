<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wicked.App.ViewModels"
             xmlns:shell="using:Wicked.App.Shell"
             x:Class="Wicked.App.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">
  <!-- Everything waiting in the footer, worst first, each with the buttons its owner gave it. -->
  <Border Classes="dialog" Width="600" MaxHeight="640" Padding="20,16">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBlock Name="NotificationsTitle" Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Name="CloseNotifications" Classes="quiet" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Escape)" AutomationProperties.Name="Close notifications">
          <shell:Icon Data="{StaticResource Icon.X}" Size="15" />
        </Button>
      </Grid>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,0,0,12">
        <Button Name="CheckNowButton" Classes="secondary" Command="{Binding CheckNowCommand}" IsEnabled="{Binding !Checking}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <shell:Icon Data="{StaticResource Icon.RefreshCw}" Size="13" />
            <TextBlock Text="Check now" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Name="WhatsNewButton" Classes="secondary" Content="What's new in your models" Command="{Binding ShowWhatsNewCommand}" IsVisible="{Binding HasUpdates}" />
        <TextBlock Grid.Column="2" Name="NotificationsStatus" Text="{Binding Status}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
      <TextBlock Name="NothingWaiting" Text="Nothing is waiting. Updates, problems and finished work show up here." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl Name="NoticeGroups" ItemsSource="{Binding Groups}" Margin="0,0,8,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NoticeGroup">
              <StackPanel Spacing="6">
                <TextBlock Classes="heading" Text="{Binding Heading}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:NoticeRow">
                      <Border Classes="pick">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                          <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
                                   Fill="{Binding Kind, Converter={x:Static shell:NoticeBrush.Instance}}" />
                          <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding !ProgressKnown}" IsVisible="{Binding HasProgress}" />
                            <ItemsControl ItemsSource="{Binding Buttons}" IsVisible="{Binding HasButtons}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:NoticeButton">
                                  <Button Classes="secondary" Content="{Binding Label}" Command="{Binding Command}" Padding="10,4" Margin="0,0,6,4" FontSize="{DynamicResource Font.Size.Small}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Classes="quiet" Padding="5" Command="{Binding GoCommand}" IsVisible="{Binding CanGo}" ToolTip.Tip="Go to where this is dealt with" AutomationProperties.Name="Go">
                              <shell:Icon Data="{StaticResource Icon.ChevronRight}" Size="14" />
                            </Button>
                            <Button Classes="quiet" Padding="5" Command="{Binding ClearCommand}" IsVisible="{Binding CanClear}" ToolTip.Tip="Clear this notice" AutomationProperties.Name="Clear">
                              <shell:Icon Data="{StaticResource Icon.X}" Size="13" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
