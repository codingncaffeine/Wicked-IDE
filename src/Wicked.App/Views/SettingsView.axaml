<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wicked.App.ViewModels"
             xmlns:shell="using:Wicked.App.Shell"
             x:Class="Wicked.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="dialog settings" Width="820" MaxHeight="720">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
        <Button Grid.Column="1" Name="CloseSettings" Classes="quiet" ToolTip.Tip="Close (Escape)"
                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseSettingsCommand}">
          <shell:Icon Data="{StaticResource Icon.X}" Size="15" />
        </Button>
      </Grid>
      <!-- The search over every setting, as VS Code's Settings editor opens with it. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBox Name="SettingsSearch" Text="{Binding SearchText}" PlaceholderText="Search settings (@modified: the ones you changed)"
                 AutomationProperties.Name="Search settings" />
        <TextBlock Grid.Column="1" Name="SettingsResult" Text="{Binding ResultText}" Classes="muted" Margin="10,0,0,0" VerticalAlignment="Center"
                   FontSize="{DynamicResource Font.Size.Small}" />
      </Grid>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="-6,0,0,12">
        <Button Name="JumpAll" Classes="quiet" Content="All settings" Command="{Binding ShowAllSettingsCommand}" />
        <Button Classes="quiet" Content="Editor" Click="OnJump" Tag="editor" />
        <Button Classes="quiet" Content="Appearance" Click="OnJump" Tag="appearance" />
        <Button Classes="quiet" Content="Files" Click="OnJump" Tag="files" />
        <Button Classes="quiet" Content="Session" Click="OnJump" Tag="session" />
        <Button Name="JumpLanguages" Classes="quiet" Content="Languages" Click="OnJump" Tag="languages" />
        <Button Name="JumpTerminal" Classes="quiet" Content="Terminal" Click="OnJump" Tag="terminal" />
        <Button Name="JumpModels" Classes="quiet" Content="Models" Click="OnJump" Tag="models" />
        <Button Name="JumpRuntime" Classes="quiet" Content="Runtime" Click="OnJump" Tag="runtime" />
        <Button Name="JumpServer" Classes="quiet" Content="Server" Click="OnJump" Tag="server" />
      </StackPanel>
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
        <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Changes apply at once and are kept in settings.json, which you can also edit by hand." />
        <Button Grid.Column="1" Classes="secondary" Content="Edit settings.json" Command="{Binding OpenJsonCommand}" />
      </Grid>

      <Grid>
      <ScrollViewer Name="SettingsSections" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsSearching}">
        <StackPanel Spacing="22" Margin="0,0,10,0">
          <StackPanel Spacing="10">
            <TextBlock Name="SectionEditor" Classes="heading" Text="EDITOR" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Classes="settings">
              <TextBlock Text="Font size" />
              <NumericUpDown Grid.Column="1" Name="FontSizeBox" Value="{Binding FontSize}" Minimum="6" Maximum="72" Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Text="Line height" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding LineHeight}" Minimum="1" Maximum="3" Increment="0.1" FormatString="0.0" Width="120" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="2" Text="Programming ligatures" />
              <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding Ligatures}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="3" Text="Tab size" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TabSize}" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="4" Text="Indent with spaces" />
              <ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding InsertSpaces}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="5" Text="Close brackets and quotes" />
              <ToggleSwitch Grid.Row="5" Grid.Column="1" IsChecked="{Binding AutoClosingBrackets}" OnContent="" OffContent="" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionAppearance" Classes="heading" Text="APPEARANCE" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" Classes="settings">
              <TextBlock Grid.Row="2" Text="Title bar" />
              <ComboBox Grid.Row="2" Grid.Column="1" Name="TitleBarBox" ItemsSource="{Binding TitleBarStyles}" SelectedItem="{Binding TitleBarStyle}" Width="280" />
              <TextBlock Grid.Row="3" Text="Caret" />
              <ComboBox Grid.Row="3" Grid.Column="1" Name="CaretBox" ItemsSource="{Binding CaretStyles}" SelectedItem="{Binding CaretStyle}" Width="180" />
              <TextBlock Text="Theme" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox Name="WindowThemeBox" ItemsSource="{Binding WindowThemes}" SelectedItem="{Binding WindowTheme}" Width="280" />
                <Button Name="ImportThemeButton" Classes="secondary" Content="Import VS Code theme…" Command="{Binding ImportThemeCommand}" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Code colours" />
              <ComboBox Grid.Row="1" Grid.Column="1" Name="CodeThemeBox" ItemsSource="{Binding CodeThemes}" SelectedItem="{Binding CodeTheme}" Width="280" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionFiles" Classes="heading" Text="FILES" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" Classes="settings">
              <TextBlock Text="Auto save" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AutoSaveModes}" SelectedItem="{Binding AutoSave}" Width="280" />
              <TextBlock Grid.Row="1" Text="Auto save delay (ms)" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding AutoSaveDelay}" Minimum="100" Maximum="60000" Increment="100" FormatString="0" Width="120" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="2" Text="Trim trailing whitespace on save" />
              <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding TrimTrailingWhitespace}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="3" Text="End files with a newline" />
              <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding InsertFinalNewline}" OnContent="" OffContent="" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionLanguages" Classes="heading" Text="LANGUAGES" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Classes="settings">
              <TextBlock Text="Language servers" />
              <ToggleSwitch Grid.Column="1" Name="LanguageServersSwitch" IsChecked="{Binding LanguageServersOn}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="1" Text="Suggestions while typing" />
              <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding QuickSuggestions}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="2" Text="Parameter hints" />
              <ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding ParameterHints}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="3" Text="Hover cards" />
              <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding Hover}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="4" Text="Inlay hints" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding LanguageServers.InlayModes}" SelectedItem="{Binding InlayHints}" Width="180" />
              <TextBlock Grid.Row="5" Text="Semantic colours" />
              <ToggleSwitch Grid.Row="5" Grid.Column="1" IsChecked="{Binding SemanticHighlighting}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="6" Text="Highlight other uses" />
              <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding OccurrencesHighlight}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="7" Text="Format on save" />
              <ToggleSwitch Grid.Row="7" Grid.Column="1" Name="FormatOnSaveSwitch" IsChecked="{Binding FormatOnSave}" OnContent="" OffContent="" />
            </Grid>
            <ItemsControl Name="ServerList" ItemsSource="{Binding LanguageServers.Servers}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerRow">
                  <Grid ColumnDefinitions="220,*,Auto" Margin="0,3">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Text="{Binding Languages}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding State}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Blocked}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" IsVisible="{Binding Blocked, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="secondary" Content="Install" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionTerminal" Classes="heading" Text="TERMINAL" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Classes="settings">
              <TextBlock Text="Font size" />
              <NumericUpDown Grid.Column="1" Value="{Binding TerminalFontSize}" Minimum="6" Maximum="48" Increment="1" FormatString="0" Width="120" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Text="Scrollback lines" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TerminalScrollback}" Minimum="100" Maximum="1000000" Increment="1000" FormatString="0" Width="160" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="2" Text="Cursor" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TerminalCursorStyles}" SelectedItem="{Binding TerminalCursorStyle}" Width="180" />
              <TextBlock Grid.Row="3" Text="Copy on selection" />
              <ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding TerminalCopyOnSelection}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="4" Text="Shell integration" />
              <ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding TerminalShellIntegration}" OnContent="" OffContent="" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionDebug" Classes="heading" Text="DEBUGGING" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="10" Classes="settings">
              <TextBlock Text="Values after lines while stopped" />
              <ToggleSwitch Grid.Column="1" Name="DebugInlineValuesSwitch" IsChecked="{Binding DebugInlineValues}" OnContent="" OffContent="" />
              <TextBlock Grid.Row="1" Text="Open Run and Debug" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OpenDebugModes}" SelectedItem="{Binding OpenDebug}" Width="280" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionSession" Classes="heading" Text="SESSION" />
            <Grid ColumnDefinitions="220,*" Classes="settings">
              <TextBlock Text="Reopen the last folder and files" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding RestoreSession}" OnContent="" OffContent="" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionModels" Classes="heading" Text="MODELS" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Classes="settings">
              <TextBlock Text="Install new models in" VerticalAlignment="Top" Margin="0,6,0,0" />
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Name="StoreLocationText" Text="{Binding StoreLocationText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="ChooseStore" Classes="secondary" Content="Choose folder…" Command="{Binding ChooseStoreCommand}" />
                  <Button Name="UseDefaultStore" Classes="quiet" Content="Use the default" Command="{Binding UseDefaultStoreCommand}" IsVisible="{Binding !UsesDefaultStore}" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                           Text="New installs go here. Models you already have stay where they are and stay listed; moving them comes later." />
              </StackPanel>

              <TextBlock Grid.Row="1" Text="Hugging Face token" VerticalAlignment="Top" Margin="0,6,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Name="TokenBox" Text="{Binding HuggingFaceToken}" PasswordChar="●" RevealPassword="{Binding ShowToken}" PlaceholderText="hf_…" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                  <ToggleButton Grid.Column="1" Classes="findopt" IsChecked="{Binding ShowToken}" ToolTip.Tip="Show the token" AutomationProperties.Name="Show token">
                    <shell:Icon Data="{StaticResource Icon.KeyRound}" Size="14" />
                  </ToggleButton>
                </Grid>
                <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                           Text="Needed for gated models (Llama, Gemma and others whose terms you accept on huggingface.co). Sent to huggingface.co only, and kept in settings.json." />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="Download speed limit" />
              <ComboBox Grid.Row="2" Grid.Column="1" Name="DownloadLimitBox" ItemsSource="{Binding DownloadLimits}" SelectedItem="{Binding DownloadLimit}" Width="180" />

              <TextBlock Grid.Row="3" Text="Look for updates" />
              <ToggleSwitch Grid.Row="3" Grid.Column="1" Name="CheckForUpdatesToggle" IsChecked="{Binding CheckForUpdates}" OnContent="" OffContent="" />

              <TextBlock Grid.Row="4" Text="A model has a newer upload" VerticalAlignment="Top" Margin="0,6,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Spacing="6">
                <ComboBox Name="UpdatePolicyBox" ItemsSource="{Binding UpdatePolicies}" SelectedItem="{Binding UpdatePolicy}" Width="460" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Name="CheckUpdatesNowButton" Classes="secondary" Content="Check now" Command="{Binding CheckUpdatesNowCommand}" IsEnabled="{Binding !CheckingUpdates}" />
                  <TextBlock Name="SettingsUpdateStatus" Text="{Binding UpdateStatus}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                           Text="Looked for on start and once a day, never in offline mode. Each model can have its own setting in its menu on the Models panel." />
              </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionRuntime" Classes="heading" Text="RUNTIME" />
            <StackPanel DataContext="{Binding Runtime}" Spacing="12" x:DataType="vm:RuntimeViewModel">
              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" Classes="settings">
                <TextBlock Text="Engine" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Name="EngineText" Text="{Binding EngineText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                  <TextBlock Name="EngineVersion" Text="{Binding VersionText}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Devices it sees" VerticalAlignment="Top" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                  <ItemsControl Name="DeviceList" ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Text}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding DevicesNote}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Backend" />
                <ComboBox Grid.Row="2" Grid.Column="1" Name="BackendBox" ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" Width="280" />
              </Grid>

              <StackPanel Spacing="8" Margin="220,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="CheckEngine" Classes="secondary" Content="Check for engine updates" Command="{Binding CheckCommand}" IsEnabled="{Binding CanRun}" />
                  <Button Name="UpdateEngine" Classes="primary" Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}" IsVisible="{Binding HasUpdate}" IsEnabled="{Binding CanRun}" />
                  <Button Name="RollbackEngine" Classes="secondary" Content="{Binding RollbackButtonText}" Command="{Binding RollbackCommand}" IsVisible="{Binding CanRollback}" IsEnabled="{Binding CanRun}" />
                </StackPanel>
                <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding ShowProgress}" />
                <TextBlock Name="RuntimeStatus" Text="{Binding Status}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="10">
            <TextBlock Name="SectionServer" Classes="heading" Text="SERVER" />
            <StackPanel DataContext="{Binding Server}" Spacing="12" x:DataType="vm:ServerViewModel">
              <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                         Text="The daemon can serve your models to other programs over the OpenAI and Anthropic APIs: VS Code, Zed, Aider, Open WebUI, curl." />
              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Classes="settings">
                <TextBlock Text="Daemon" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Classes="state" Classes.loaded="{Binding DaemonRunning}" VerticalAlignment="Center" />
                    <TextBlock Name="DaemonStateText" Text="{Binding DaemonText}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Name="GatewayStateText" Text="{Binding GatewayText}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                             Foreground="{Binding GatewayProblem, Converter={x:Static shell:ProblemBrush.Instance}}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="StartServerButton" Classes="secondary" Content="Start the daemon" Command="{Binding StartDaemonCommand}" IsEnabled="{Binding CanStart}" />
                    <Button Name="StopServerButton" Classes="secondary" Content="Stop the daemon" Command="{Binding StopDaemonCommand}" IsEnabled="{Binding CanStop}" />
                  </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Serve the API" />
                <ToggleSwitch Grid.Row="1" Grid.Column="1" Name="ServerEnabledToggle" IsChecked="{Binding Enabled}" OnContent="" OffContent="" />

                <TextBlock Grid.Row="2" Text="Port" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Name="ServerPortBox" Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" Width="140" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="3" Text="Reachable from the network" VerticalAlignment="Top" Margin="0,6,0,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                  <ToggleSwitch Name="ServerLanToggle" IsChecked="{Binding ListenOnLan}" OnContent="" OffContent="" />
                  <Border Name="LanWarning" Classes="alert" IsVisible="{Binding HasLanWarning}">
                    <TextBlock Text="{Binding LanWarning}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Load a model when asked for" />
                <ToggleSwitch Grid.Row="4" Grid.Column="1" Name="ServerAutoLoadToggle" IsChecked="{Binding AutoLoad}" OnContent="" OffContent="" />

                <TextBlock Grid.Row="5" Text="Web pages allowed to call it" VerticalAlignment="Top" Margin="0,6,0,0" />
                <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
                  <TextBox Name="ServerCorsBox" Text="{Binding Cors}" AcceptsReturn="True" Height="70" Width="360" HorizontalAlignment="Left" PlaceholderText="http://localhost:3000" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" Text="One address per line. Programs that are not web pages need nothing here." />
                </StackPanel>

                <TextBlock Grid.Row="6" Text="Largest request (MB)" />
                <NumericUpDown Grid.Row="6" Grid.Column="1" Name="ServerMaxBox" Value="{Binding MaxRequestMB}" Minimum="1" Maximum="1024" Increment="8" FormatString="0" Width="140" HorizontalAlignment="Left" />
              </Grid>

              <StackPanel Spacing="8" Margin="0,4,0,0">
                <TextBlock Classes="heading" Text="API KEYS" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                           Text="With no key, only this machine is answered. Once one exists, every request needs one: Authorization: Bearer … or x-api-key." />
                <ItemsControl Name="KeyList" ItemsSource="{Binding Keys}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ApiKeyRow">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" FontFamily="monospace" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="Revoke" Command="{Binding RevokeCommand}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Name="NewKeyNameBox" Text="{Binding NewKeyName}" PlaceholderText="Name, e.g. Continue" Width="240" />
                  <Button Name="CreateKeyButton" Classes="secondary" Content="Create a key" Command="{Binding CreateKeyCommand}" />
                </StackPanel>
                <Border Name="NewKeyBox" Classes="alert" IsVisible="{Binding HasNewKey}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Copy this key now. It is not kept and cannot be shown again." TextWrapping="Wrap" />
                    <TextBox Name="NewKeyText" Text="{Binding NewKey}" IsReadOnly="True" FontFamily="monospace" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="CopyNewKeyButton" Classes="secondary" Content="Copy" Command="{Binding CopyNewKeyCommand}" />
                      <Button Name="HideNewKeyButton" Classes="quiet" Content="I have it" Command="{Binding DismissNewKeyCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="8" Margin="0,4,0,0">
                <TextBlock Classes="heading" Text="CONNECT" />
                <ItemsControl Name="SnippetList" ItemsSource="{Binding Snippets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SnippetRow">
                      <Border Classes="pick" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                              <TextBlock Text="{Binding Program}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Where}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Command="{Binding CopyCommand}" VerticalAlignment="Top" AutomationProperties.Name="Copy">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <shell:Icon Data="{StaticResource Icon.Copy}" Size="13" />
                                <TextBlock Text="Copy" />
                              </StackPanel>
                            </Button>
                          </Grid>
                          <SelectableTextBlock Text="{Binding Text}" FontFamily="monospace" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Grid ColumnDefinitions="220,*" Classes="settings">
                <TextBlock Text="Start at login" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <ToggleSwitch Name="StartAtLoginToggle" IsChecked="{Binding StartAtLogin}" OnContent="" OffContent="" />
                  <TextBlock Name="StartAtLoginStatus" Text="{Binding StartAtLoginText}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                             Text="Adds wickedd.service to your systemd user units (~/.config/systemd/user) so the daemon is running when you sit down." />
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Every setting, searchable, as VS Code's Settings editor lists them: made from WickedSettings itself, so none is missed. -->
      <ScrollViewer Name="AllSettings" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsSearching}">
        <ItemsControl Name="SettingRows" ItemsSource="{Binding Rows}" Margin="0,0,10,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:SettingRow">
              <Grid ColumnDefinitions="3,*" Margin="0,0,0,16" AutomationProperties.Name="{Binding Heading}">
                <!-- The mark VS Code draws beside a changed setting. -->
                <Border Width="3" CornerRadius="1.5" Background="{DynamicResource Brush.Accent}" IsVisible="{Binding IsModified}" Margin="0,2" />
                <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Name="ResetSetting" Classes="quiet" Padding="6,2" Content="Reset" Command="{Binding ResetCommand}" IsVisible="{Binding IsModified}"
                            ToolTip.Tip="Back to the default" FontSize="{DynamicResource Font.Size.Small}" />
                    <Button Grid.Column="2" Name="SettingMore" Classes="quiet" Padding="4" ToolTip.Tip="More actions" AutomationProperties.Name="More actions"
                            Click="OnSettingMore">
                      <shell:Icon Data="{StaticResource Icon.Ellipsis}" Size="14" />
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                  <ToggleSwitch Name="SettingToggle" IsVisible="{Binding IsToggle}" IsChecked="{Binding ToggleValue}" OnContent="" OffContent="" />
                  <NumericUpDown Name="SettingNumber" IsVisible="{Binding IsNumber}" Value="{Binding NumberValue}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                 Increment="{Binding Increment}" FormatString="{Binding NumberFormat}" Width="160" HorizontalAlignment="Left" />
                  <TextBox Name="SettingText" IsVisible="{Binding IsText}" Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" MaxWidth="420" HorizontalAlignment="Stretch" />
                  <TextBox Name="SettingSecret" IsVisible="{Binding IsSecret}" Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}" PasswordChar="●" MaxWidth="420" HorizontalAlignment="Stretch" />
                  <ComboBox Name="SettingChoice" IsVisible="{Binding IsChoice}" ItemsSource="{Binding Values}" SelectedItem="{Binding ChoiceValue}" Width="240" />
                  <Button Name="SettingJson" IsVisible="{Binding IsJson}" Classes="secondary" Content="Edit in settings.json" HorizontalAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenJsonCommand}" />
                  <TextBlock Text="{Binding Key}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" FontFamily="monospace" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
