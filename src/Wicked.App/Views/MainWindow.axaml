<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wicked.App.ViewModels"
        xmlns:views="using:Wicked.App.Views"
        xmlns:shell="using:Wicked.App.Shell"
        xmlns:chat="using:Wicked.App.Chat"
        xmlns:search="using:Wicked.App.Search"
        xmlns:git="using:Wicked.App.Git"
        xmlns:proj="using:Wicked.App.Projects"
        xmlns:tasks="using:Wicked.App.Tasks"
        xmlns:dbg="using:Wicked.App.Debug"
        xmlns:ext="using:Wicked.App.Extensions"
        xmlns:assist="using:Wicked.App.Assistant"
        x:Class="Wicked.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        Icon="/Assets/logo.png"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">

  <Border Name="Frame" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
    <Grid RowDefinitions="40,*,28">

      <!-- ── Title bar: the mark, the command centre in the middle, the layout toggles and the caption buttons. ── -->
      <Grid Name="TitleBar" Background="{DynamicResource Brush.Ground}" ColumnDefinitions="*,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="9" Margin="14,0,0,0" VerticalAlignment="Center">
          <Image Source="/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="Wicked" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Button Grid.Column="1" Name="CommandCentre" Classes="command-centre" Width="520" Click="OnCommandCentre"
                ToolTip.Tip="Search files, commands and models">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <shell:Icon Data="{StaticResource Icon.Search}" Size="14" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding CommandCentreText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" Classes="kbd"><TextBlock Text="Ctrl+P" /></Border>
          </Grid>
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" Margin="0,0,6,0">
          <Button Classes="quiet" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Side bar (Ctrl+B)">
            <shell:Icon Data="{StaticResource Icon.PanelLeft}" />
          </Button>
          <Button Name="PanelToggle" Classes="quiet" Command="{Binding TogglePanelCommand}" ToolTip.Tip="Panel: problems, build output, terminal (Ctrl+J)">
            <shell:Icon Data="{StaticResource Icon.PanelBottom}" />
          </Button>
          <Button Classes="quiet" Command="{Binding ToggleAssistantCommand}" ToolTip.Tip="Assistant (Ctrl+L)">
            <shell:Icon Data="{StaticResource Icon.PanelRight}" />
          </Button>
          <Rectangle Width="1" Height="16" Margin="6,0" Fill="{DynamicResource Brush.Border}" VerticalAlignment="Center" />
          <Button Classes="caption" Click="OnMinimize" ToolTip.Tip="Minimise">
            <shell:Icon Data="{StaticResource Icon.Minus}" Size="15" StrokeWidth="1.5" />
          </Button>
          <Button Classes="caption" Click="OnToggleMaximize" ToolTip.Tip="Maximise or restore">
            <shell:Icon Data="{StaticResource Icon.Square}" Size="13" StrokeWidth="1.6" />
          </Button>
          <Button Classes="caption close" Click="OnClose" ToolTip.Tip="Close">
            <shell:Icon Data="{StaticResource Icon.X}" Size="15" StrokeWidth="1.5" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- ── Body: the rail on the ground, then the floating panels. ── -->
      <Grid Grid.Row="1" Name="Body" Margin="0,0,6,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="260" MinWidth="0" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="*" MinWidth="320" />
          <ColumnDefinition Width="6" />
          <ColumnDefinition Width="380" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- The rail -->
        <DockPanel Margin="0,2,0,8">
          <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
            <Button Name="RailSettings" Classes="rail" ToolTip.Tip="Settings (Ctrl+,)" Command="{Binding OpenSettingsCommand}">
              <shell:Icon Data="{StaticResource Icon.Settings}" Size="19" />
            </Button>
          </StackPanel>
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <Button Name="RailExplorer" Classes="rail" Classes.active="{Binding IsExplorer}" ToolTip.Tip="Explorer (Ctrl+Shift+E)"
                    Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Explorer}">
              <shell:Icon Data="{StaticResource Icon.Files}" Size="19" />
            </Button>
            <Button Name="RailSearch" Classes="rail" Classes.active="{Binding IsSearch}" ToolTip.Tip="Search (Ctrl+Shift+F)"
                    Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Search}">
              <shell:Icon Data="{StaticResource Icon.Search}" Size="19" />
            </Button>
            <Button Name="RailSourceControl" Classes="rail" Classes.active="{Binding IsSourceControl}" ToolTip.Tip="Source control (Ctrl+Shift+G)"
                    Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.SourceControl}">
              <shell:Icon Data="{StaticResource Icon.GitBranch}" Size="19" />
            </Button>
            <Button Name="RailOutline" Classes="rail" Classes.active="{Binding IsOutline}" ToolTip.Tip="Outline: the file's symbols"
                    Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Outline}">
              <shell:Icon Data="{StaticResource Icon.ListTree}" Size="19" />
            </Button>
            <Button Name="RailTesting" Classes="rail" Classes.active="{Binding IsTesting}" ToolTip.Tip="Testing"
                    Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Testing}">
              <shell:Icon Data="{StaticResource Icon.FlaskConical}" Size="19" />
            </Button>
            <Button Name="RailDebug" Classes="rail" Classes.active="{Binding IsDebug}" ToolTip.Tip="Run and Debug (Ctrl+Shift+D)"
                    Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Debug}">
              <shell:Icon Data="{StaticResource Icon.Bug}" Size="19" />
            </Button>
            <Button Name="RailModels" Classes="rail" Classes.active="{Binding IsModels}" ToolTip.Tip="Models (Ctrl+Shift+M)"
                    Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Models}">
              <shell:Icon Data="{StaticResource Icon.Boxes}" Size="19" />
            </Button>
            <!-- Extensions, and the panels extensions add -->
            <Button Name="RailExtensions" Classes="rail" Classes.active="{Binding IsExtensions}" ToolTip.Tip="Extensions (Ctrl+Shift+X)"
                    Command="{Binding ShowPanelCommand}" CommandParameter="{x:Static vm:SidePanel.Extensions}">
              <shell:Icon Data="{StaticResource Icon.Puzzle}" Size="19" />
            </Button>
            <ItemsControl Name="RailCustomPanels" ItemsSource="{Binding CustomPanels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:CustomPanel">
                  <Button Classes="rail" Classes.active="{Binding IsOpen}" ToolTip.Tip="{Binding Title}"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ToggleCustomPanelCommand}" CommandParameter="{Binding}">
                    <shell:Icon Data="{Binding IconKey, Converter={x:Static assist:IconKey.Instance}}" Size="19" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DockPanel>

        <!-- The side panel -->
        <Border Grid.Column="1" Name="SidePanel" Classes="panel" Margin="0,0,0,6" IsVisible="{Binding SidebarVisible}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,12,10,8">
              <TextBlock Classes="heading" Text="{Binding PanelTitle}" VerticalAlignment="Center" />
            </Grid>
            <Panel>
              <views:ExplorerView DataContext="{Binding Workbench}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsExplorer}" />
              <views:ModelsView DataContext="{Binding Models}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsModels}" />
              <views:OutlineView DataContext="{Binding Outline}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsOutline}" />
              <search:SearchView Name="SearchPanel" DataContext="{Binding Search}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSearch}" />
              <git:SourceControlView DataContext="{Binding SourceControl}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSourceControl}" />
              <tasks:TestingView DataContext="{Binding Testing}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsTesting}" />
              <dbg:DebugView DataContext="{Binding Debugger}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsDebug}" />
              <ext:ExtensionsView DataContext="{Binding Extensions}" IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsExtensions}" />
              <ContentControl Name="CustomPanelContent" Content="{Binding ActiveCustomPanel.View}" IsVisible="{Binding IsCustomPanel}" />
              <StackPanel Margin="14,8" Spacing="4" IsVisible="{Binding ShowsPanelPlaceholder}">
                <TextBlock Text="{Binding PanelEmptyTitle}" />
                <TextBlock Classes="muted" Text="{Binding PanelEmptyText}" TextWrapping="Wrap" />
              </StackPanel>
            </Panel>
          </DockPanel>
        </Border>
        <GridSplitter Grid.Column="2" Classes="gap" ResizeDirection="Columns" IsVisible="{Binding SidebarVisible}" />

        <!-- The editor groups, and the panel under them (Problems, Output, Terminal, …) -->
        <Grid Grid.Column="3" Name="EditorColumn" RowDefinitions="*,0,0">
          <Border Name="Editor" Classes="panel editor" Margin="0,0,0,6">
            <views:EditorAreaView DataContext="{Binding Workbench}" />
          </Border>
          <dbg:DebugToolbarView Name="DebugToolbar" DataContext="{Binding Debugger}" HorizontalAlignment="Center" VerticalAlignment="Top" />
          <GridSplitter Grid.Row="1" Name="PanelSplitter" Classes="gap" ResizeDirection="Rows" IsVisible="{Binding BottomPanel.IsVisible}" />
          <Border Grid.Row="2" Name="PanelArea" Classes="panel" Margin="0,0,0,6" IsVisible="{Binding BottomPanel.IsVisible}">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,6,6,0">
                <ItemsControl Name="PanelTabs" ItemsSource="{Binding BottomPanel.Tabs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="shell:PanelTab">
                      <Button Classes="paneltab" Classes.active="{Binding IsActive}"
                              Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).BottomPanel.SelectCommand}" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Title}" />
                          <Border Classes="badge" IsVisible="{Binding HasBadge}"><TextBlock Text="{Binding BadgeText}" /></Border>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                  <Button Classes="quiet" Command="{Binding BottomPanel.ToggleMaximizedCommand}" ToolTip.Tip="Maximise or restore the panel">
                    <shell:Icon Data="{StaticResource Icon.ChevronUp}" Size="15" />
                  </Button>
                  <Button Name="PanelClose" Classes="quiet" Command="{Binding BottomPanel.HideCommand}" ToolTip.Tip="Hide the panel (Ctrl+J)">
                    <shell:Icon Data="{StaticResource Icon.X}" Size="15" />
                  </Button>
                </StackPanel>
              </Grid>
              <ContentControl Name="PanelContent" Content="{Binding BottomPanel.ActiveView}" Margin="0,4,0,0" />
            </DockPanel>
          </Border>
        </Grid>
        <GridSplitter Grid.Column="4" Classes="gap" ResizeDirection="Columns" IsVisible="{Binding AssistantVisible}" />

        <!-- The assistant -->
        <Border Grid.Column="5" Name="Assistant" Classes="panel" Margin="0,0,0,6" IsVisible="{Binding AssistantVisible}">
          <chat:ChatView Name="AssistantChat" DataContext="{Binding Chat}" />
        </Border>
      </Grid>

      <!-- ── Footer: the waiting notice on the left (a click goes where it is dealt with), the editor and daemon on the right. ── -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="10,0,8,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Button Name="NoticeButton" Classes="quiet" Padding="6,2" HorizontalAlignment="Left"
                IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                Command="{Binding OpenNoticeCommand}" ToolTip.Tip="{Binding NoticeTip}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="7" Height="7" Fill="{Binding Notice.Kind, Converter={x:Static shell:NoticeBrush.Instance}}" VerticalAlignment="Center" />
            <TextBlock Name="NoticeText" Text="{Binding Notice.Text}" FontSize="{DynamicResource Font.Size.Small}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
            <ProgressBar Width="80" MinWidth="80" Height="3" MinHeight="3" VerticalAlignment="Center"
                         Minimum="0" Maximum="1" Value="{Binding Notice.Progress, FallbackValue=0}"
                         IsIndeterminate="{Binding Notice.Progress, Converter={x:Static ObjectConverters.IsNull}}"
                         IsVisible="{Binding IsProgressNotice}" />
          </StackPanel>
        </Button>
        <Button Name="MoreNoticesButton" Classes="quiet" Padding="6,2" Command="{Binding OpenNotificationsCommand}" ToolTip.Tip="Everything waiting: updates, problems, finished work"
                IsVisible="{Binding MoreNotices, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="More notifications">
          <TextBlock Name="MoreNoticesText" Text="{Binding MoreNotices}" FontSize="{DynamicResource Font.Size.Small}" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" />
        </Button>
        </StackPanel>

        <Button Grid.Column="1" Name="ModelStatus" Classes="quiet" Padding="6,2" Margin="0,0,10,0" IsVisible="{Binding Models.HasRuntimeStatus}"
                Command="{Binding ShowModelsStatusCommand}" ToolTip.Tip="Models: load, unload and run settings" AutomationProperties.Name="Model status">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Classes="state" Classes.loaded="{Binding Models.RuntimeLoaded}" Classes.loading="{Binding Models.RuntimeLoading}" Classes.failed="{Binding Models.RuntimeFailed}" />
            <TextBlock Name="ModelStatusText" Text="{Binding Models.RuntimeStatus}" FontSize="{DynamicResource Font.Size.Small}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" Spacing="2">
          <Button Name="BranchStatus" Classes="status" Command="{Binding ShowSourceControlCommand}" IsVisible="{Binding SourceControl.BranchName.Length}"
                  ToolTip.Tip="Source control: the branch, and commits to pull and push" AutomationProperties.Name="Branch">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <shell:Icon Data="{StaticResource Icon.GitBranch}" Size="13" />
              <TextBlock Name="BranchText" Text="{Binding SourceControl.BranchName}" VerticalAlignment="Center" />
              <TextBlock Name="SyncStatus" Text="{Binding SourceControl.SyncText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Name="BlameStatus" Text="{Binding SourceControl.BlameStatus}" Classes="status" MaxWidth="360" TextTrimming="CharacterEllipsis" />
          <Button Name="TaskStatus" Classes="status" Command="{Binding Tasks.ShowRunningOutputCommand}" IsVisible="{Binding Tasks.RunningText.Length}"
                  ToolTip.Tip="{Binding Tasks.RunningTip}" AutomationProperties.Name="Running tasks">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <shell:Icon Data="{StaticResource Icon.Play}" Size="12" Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock Name="TaskStatusText" Text="{Binding Tasks.RunningText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="ProblemsStatus" Classes="status" Command="{Binding ShowProblemsCommand}" ToolTip.Tip="{Binding ProblemsTip}" AutomationProperties.Name="Problems">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <shell:Icon Data="{StaticResource Icon.CircleX}" Size="13" />
              <TextBlock Name="ErrorCount" Text="{Binding Language.Problems.Errors}" VerticalAlignment="Center" />
              <shell:Icon Data="{StaticResource Icon.TriangleAlert}" Size="13" Margin="4,0,0,0" />
              <TextBlock Name="WarningCount" Text="{Binding Language.Problems.Warnings}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Name="LanguageStatus" Text="{Binding Language.StatusText}" Classes="status" />
        </StackPanel>
        <TextBlock Grid.Column="2" Name="CaretStatus" Text="{Binding CaretText}" Classes="status" />
        <TextBlock Grid.Column="3" Name="DocumentStatus" Text="{Binding DocumentText}" Classes="status" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="0,0,14,0" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                   Fill="{Binding DaemonRunning, Converter={x:Static shell:DaemonBrush.Instance}}" />
          <TextBlock Name="DaemonText" Text="{Binding DaemonText}" FontSize="{DynamicResource Font.Size.Small}"
                     Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="5" Text="{Binding VersionText}" FontSize="{DynamicResource Font.Size.Small}"
                   Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" />
      </Grid>

      <!-- ── Overlays ── -->
      <views:QuickInputView Name="Palette" Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding QuickInput}"
                            IsVisible="{Binding IsOpen}" VerticalAlignment="Top" />

      <Border Name="SettingsLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding SettingsOpen}">
        <views:SettingsView DataContext="{Binding SettingsSheet}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Border Name="BrowseLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding Models.Browse.IsOpen}">
        <views:BrowseView DataContext="{Binding Models.Browse}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- A question from the model half: the licence to accept, a delete to confirm. Above the sheets, below the save prompt. -->
      <Border Name="PromptLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding Models.Prompt, Converter={x:Static ObjectConverters.IsNotNull}}">
        <views:PromptView DataContext="{Binding Models.Prompt}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Border Name="RunSettingsLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding Models.RunSettings, Converter={x:Static ObjectConverters.IsNotNull}}">
        <views:RunSettingsView DataContext="{Binding Models.RunSettings}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Border Name="PromptsLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding Chat.PromptEditor, Converter={x:Static ObjectConverters.IsNotNull}}">
        <chat:SystemPromptsView DataContext="{Binding Chat.PromptEditor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <!-- Git asking for a credential: above the sheets, below the save prompt. -->
      <Border Name="GitPromptLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding SourceControl.Prompt, Converter={x:Static ObjectConverters.IsNotNull}}">
        <git:GitPromptView DataContext="{Binding SourceControl.Prompt}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Border Name="NotificationsLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding Notifications.IsOpen}">
        <views:NotificationsView DataContext="{Binding Notifications}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Border Name="NewProjectLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding NewProject.IsOpen}">
        <proj:NewProjectView DataContext="{Binding NewProject}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Border Name="WhatsNewLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding WhatsNew.IsOpen}">
        <views:WhatsNewView DataContext="{Binding WhatsNew}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <Border Name="DialogLayer" Grid.RowSpan="3" Background="#99000000" IsVisible="False">
        <Border Classes="dialog" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="10">
            <TextBlock Name="DialogMessage" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Name="DialogDetail" Classes="secondary" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
              <Button Name="DialogCancel" Classes="secondary" Content="Cancel" Click="OnDialogCancel" />
              <Button Name="DialogDontSave" Classes="secondary" Content="Don't Save" Click="OnDialogDontSave" />
              <Button Name="DialogSave" Classes="primary" Content="Save" Click="OnDialogSave" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
