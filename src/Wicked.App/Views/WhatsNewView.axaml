<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wicked.App.ViewModels"
             xmlns:shell="using:Wicked.App.Shell"
             x:Class="Wicked.App.Views.WhatsNewView"
             x:DataType="vm:WhatsNewViewModel">
  <!-- What changed in each installed model that has a newer upload: the commit it is at and the one on offer, the size, the commit titles. -->
  <Border Classes="dialog" Width="680" MaxHeight="660" Padding="20,16">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
        <TextBlock Text="What's new in your models" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Name="CloseWhatsNew" Classes="quiet" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Escape)" AutomationProperties.Name="Close what's new">
          <shell:Icon Data="{StaticResource Icon.X}" Size="15" />
        </Button>
      </Grid>
      <TextBlock DockPanel.Dock="Top" Name="WhatsNewSummary" Text="{Binding Summary}" Classes="muted" Margin="0,0,0,12" TextWrapping="Wrap" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl Name="WhatsNewRows" ItemsSource="{Binding Rows}" Margin="0,0,8,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:WhatsNewRow">
              <Border Classes="pick">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Name="WhatsNewName" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding PolicyText}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" />
                  </Grid>
                  <TextBlock Text="{Binding Detail}" Classes="secondary" TextWrapping="Wrap" />
                  <TextBlock Name="WhatsNewRevisions" Text="{Binding Revisions}" Classes="muted" FontFamily="monospace" FontSize="{DynamicResource Font.Size.Small}" IsVisible="{Binding IsUpload}" />
                  <TextBlock Name="WhatsNewSize" Text="{Binding SizeText}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" IsVisible="{Binding SizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <ItemsControl ItemsSource="{Binding Titles}" IsVisible="{Binding HasTitles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock Text="•" Classes="muted" />
                          <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Name="WhatsNewUpdate" Classes="primary" Content="Update" Command="{Binding ApplyCommand}" IsVisible="{Binding CanUpdate}" IsEnabled="{Binding !Busy}" Padding="12,5" />
                    <Button Classes="secondary" Content="Dismiss" Command="{Binding DismissCommand}" IsEnabled="{Binding !Busy}" Padding="12,5" />
                    <Button Classes="secondary" Content="Don't tell me about this model" Command="{Binding MuteCommand}" IsEnabled="{Binding !Busy}" Padding="12,5" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
