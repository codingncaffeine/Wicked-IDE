<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wicked.App.ViewModels"
             xmlns:shell="using:Wicked.App.Shell"
             x:Class="Wicked.App.Views.ModelsView"
             x:DataType="vm:ModelsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,0,12,12" Spacing="14">
      <!-- This PC -->
      <Border Classes="machine">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <shell:Icon Data="{StaticResource Icon.Cpu}" Size="14" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,1,0,0" />
          <TextBlock Grid.Column="1" Name="HardwareText" Text="{Binding HardwareText}" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text.Secondary}" />
        </Grid>
      </Border>

      <!-- Recommended -->
      <StackPanel Spacing="8">
        <TextBlock Classes="heading" Text="RECOMMENDED FOR THIS PC" />
        <TextBlock Classes="muted" Text="Finding the best fit…" IsVisible="{Binding !Ready}" />
        <ItemsControl Name="PickList" ItemsSource="{Binding Picks}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:PickCard">
              <Border Classes="pick">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="*,Auto">
                    <Border Classes="role" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Role}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Quant}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding Reason}" Classes="secondary" TextWrapping="Wrap" FontSize="{DynamicResource Font.Size.Small}" />
                  <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource Font.Size.Small}" />
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,10,0">
                      <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding Busy}" />
                      <TextBlock Text="{Binding Status}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="primary" Content="Install" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" IsVisible="{Binding Installed}" VerticalAlignment="Center">
                      <shell:Icon Data="{StaticResource Icon.CircleCheck}" Size="14" Foreground="{DynamicResource Brush.Success}" />
                      <TextBlock Text="Installed" Foreground="{DynamicResource Brush.Success}" FontSize="{DynamicResource Font.Size.Small}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Installed -->
      <StackPanel Spacing="6">
        <TextBlock Classes="heading" Text="INSTALLED" />
        <TextBlock Classes="muted" Text="Nothing yet." IsVisible="{Binding !Installed.Count}" />
        <ItemsControl ItemsSource="{Binding Installed}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:InstalledRow">
              <StackPanel Margin="0,3">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Details}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Engine -->
      <StackPanel Spacing="4">
        <TextBlock Classes="heading" Text="ENGINE" />
        <TextBlock Text="{Binding EngineText}" Classes="secondary" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
