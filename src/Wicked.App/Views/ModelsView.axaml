<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wicked.App.ViewModels"
             xmlns:shell="using:Wicked.App.Shell"
             x:Class="Wicked.App.Views.ModelsView"
             x:DataType="vm:ModelsViewModel">
  <UserControl.Resources>
    <!-- One installed model: its state, update and run controls; used by the chat list and the code completion list. -->
    <DataTemplate x:Key="InstalledRowTemplate" DataType="vm:InstalledRow">
      <Grid ColumnDefinitions="*,Auto" Margin="0,3" Classes="installed">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Details}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="update" Text="{Binding UpdateText}" IsVisible="{Binding HasUpdate}" FontSize="{DynamicResource Font.Size.Small}"
                     Foreground="{DynamicResource Brush.Accent.Hover}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasUpdate}">
            <Button Name="UpdateModel" Classes="accent-soft" Content="Update" Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}" Padding="8,2" FontSize="{DynamicResource Font.Size.Small}" />
            <Button Name="WhatsNewLink" Classes="link" Content="What's new" Command="{Binding WhatsNewCommand}" FontSize="{DynamicResource Font.Size.Small}" />
          </StackPanel>
          <TextBlock Text="Updating…" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" IsVisible="{Binding Updating}" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasState}" Margin="0,2,0,0">
            <Ellipse Classes="state" Classes.loaded="{Binding IsLoaded}" Classes.loading="{Binding IsLoading}" Classes.failed="{Binding IsFailed}" />
            <TextBlock Name="RunStateText" Text="{Binding StateText}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" MaxWidth="190" />
          </StackPanel>
          <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding LoadProgress}" IsIndeterminate="{Binding !LoadProgressKnown}"
                       IsVisible="{Binding IsLoading}" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Classes="quiet" Padding="5" Command="{Binding LoadCommand}" IsVisible="{Binding CanLoad}" ToolTip.Tip="Load into memory" AutomationProperties.Name="Load">
            <shell:Icon Data="{StaticResource Icon.Play}" Size="14" />
          </Button>
          <Button Classes="quiet" Padding="5" Command="{Binding UnloadCommand}" IsVisible="{Binding CanUnload}" ToolTip.Tip="Unload from memory" AutomationProperties.Name="Unload">
            <shell:Icon Data="{StaticResource Icon.Power}" Size="14" />
          </Button>
          <Button Classes="quiet" Padding="5" Command="{Binding RunSettingsCommand}" IsVisible="{Binding CanRun}" ToolTip.Tip="Run settings" AutomationProperties.Name="Run settings">
            <shell:Icon Data="{StaticResource Icon.SlidersHorizontal}" Size="14" />
          </Button>
          <Button Classes="quiet" Padding="5" VerticalAlignment="Top" ToolTip.Tip="More" AutomationProperties.Name="More">
          <shell:Icon Data="{StaticResource Icon.Ellipsis}" Size="15" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Show in folder" Command="{Binding ShowInFolderCommand}">
                <MenuItem.Icon>
                  <shell:Icon Data="{StaticResource Icon.FolderOpen}" Size="14" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Updates" Name="UpdatesMenu">
                <MenuItem Header="Ask me first" Command="{Binding SetPolicyCommand}" CommandParameter="notify" ToggleType="Radio" GroupName="policy" IsChecked="{Binding IsNotify, Mode=OneWay}" />
                <MenuItem Header="Update automatically" Command="{Binding SetPolicyCommand}" CommandParameter="auto" ToggleType="Radio" GroupName="policy" IsChecked="{Binding IsAuto, Mode=OneWay}" />
                <MenuItem Header="Never (pin this version)" Command="{Binding SetPolicyCommand}" CommandParameter="pin" ToggleType="Radio" GroupName="policy" IsChecked="{Binding IsPinned, Mode=OneWay}" />
              </MenuItem>
              <MenuItem Header="Delete…" Command="{Binding DeleteCommand}">
                <MenuItem.Icon>
                  <shell:Icon Data="{StaticResource Icon.Trash2}" Size="14" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <!-- A recommendation: the model, why it suits this PC, and Install; used by the chat and the code completion sections. -->
    <DataTemplate x:Key="PickCardTemplate" DataType="vm:PickCard">
      <Border Classes="pick">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="*,Auto">
            <Border Classes="role" HorizontalAlignment="Left">
              <TextBlock Text="{Binding Role}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Quant}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
          <TextBlock Text="{Binding Reason}" Classes="secondary" TextWrapping="Wrap" FontSize="{DynamicResource Font.Size.Small}" />
          <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap" FontSize="{DynamicResource Font.Size.Small}" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <StackPanel VerticalAlignment="Center" Spacing="4" Margin="0,0,10,0">
              <ProgressBar Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding Item.Progress}" IsVisible="{Binding Item.Busy}" />
              <TextBlock Text="{Binding Item.Status}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="Install" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding Item.Busy}" VerticalAlignment="Center">
              <Button Classes="quiet" Command="{Binding Item.PauseCommand}" IsVisible="{Binding Item.CanPause}"
                      ToolTip.Tip="Pause the download" AutomationProperties.Name="Pause">
                <shell:Icon Data="{StaticResource Icon.Pause}" Size="14" />
              </Button>
              <Button Classes="quiet" Command="{Binding Item.ResumeCommand}" IsVisible="{Binding Item.CanResume}"
                      ToolTip.Tip="Resume the download" AutomationProperties.Name="Resume">
                <shell:Icon Data="{StaticResource Icon.Play}" Size="14" />
              </Button>
              <Button Classes="quiet" Command="{Binding Item.CancelCommand}"
                      ToolTip.Tip="Cancel and remove what was downloaded" AutomationProperties.Name="Cancel">
                <shell:Icon Data="{StaticResource Icon.X}" Size="14" />
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" IsVisible="{Binding Installed}" VerticalAlignment="Center">
              <shell:Icon Data="{StaticResource Icon.CircleCheck}" Size="14" Foreground="{DynamicResource Brush.Success}" />
              <TextBlock Text="Installed" Foreground="{DynamicResource Brush.Success}" FontSize="{DynamicResource Font.Size.Small}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
  <Button DockPanel.Dock="Bottom" Name="BrowseAll" Classes="accent-soft" Command="{Binding OpenBrowseCommand}" Margin="12,0,12,12" HorizontalAlignment="Stretch">
    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
      <shell:Icon Data="{StaticResource Icon.Boxes}" Size="14" />
      <TextBlock Text="Browse all models" />
    </StackPanel>
  </Button>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="12,0,12,12" Spacing="14">
      <!-- This PC -->
      <Border Classes="machine">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <shell:Icon Data="{StaticResource Icon.Cpu}" Size="14" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,1,0,0" />
          <TextBlock Grid.Column="1" Name="HardwareText" Text="{Binding HardwareText}" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text.Secondary}" />
        </Grid>
      </Border>

      <!-- Recommended -->
      <StackPanel Spacing="8">
        <TextBlock Classes="heading" Text="CHAT MODELS FOR THIS PC" />
        <TextBlock Classes="muted" Text="Finding the best fit…" IsVisible="{Binding !Ready}" />
        <ItemsControl Name="PickList" ItemsSource="{Binding Picks}" ItemTemplate="{StaticResource PickCardTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel Name="CompletionPickSection" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding !!CompletionPicks.Count}">
          <TextBlock Classes="heading" Text="CODE COMPLETION FOR THIS PC" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                     Text="Optional. A small model that suggests the rest of a line as you type in the editor. It does not chat." />
          <ItemsControl Name="CompletionPickList" ItemsSource="{Binding CompletionPicks}" ItemTemplate="{StaticResource PickCardTemplate}" />
        </StackPanel>
      </StackPanel>

      <!-- Installed -->
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="heading" Text="INSTALLED" VerticalAlignment="Center" />
          <Button Grid.Column="1" Name="CheckUpdates" Classes="quiet" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !CheckingUpdates}"
                  ToolTip.Tip="Look for newer uploads of the models you have" Padding="6,3">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <shell:Icon Data="{StaticResource Icon.RefreshCw}" Size="12" />
              <TextBlock Text="Check for updates" FontSize="{DynamicResource Font.Size.Small}" />
            </StackPanel>
          </Button>
        </Grid>
        <TextBlock Name="UpdateStatus" Classes="muted" Text="{Binding UpdateStatus}" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                   IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="muted" Text="Nothing yet." IsVisible="{Binding !Installed.Count}" />
        <ItemsControl Name="InstalledList" ItemsSource="{Binding ChatInstalled}" ItemTemplate="{StaticResource InstalledRowTemplate}" />
        <StackPanel Name="CompletionSection" Spacing="4" Margin="0,8,0,0" IsVisible="{Binding !!CompletionInstalled.Count}">
          <TextBlock Classes="heading" Text="CODE COMPLETION ONLY" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap"
                     Text="These fill in code as you type in the editor. They cannot chat, so the chat does not list them." />
          <ItemsControl Name="CompletionList" ItemsSource="{Binding CompletionInstalled}" ItemTemplate="{StaticResource InstalledRowTemplate}" />
        </StackPanel>
      </StackPanel>

      <!-- Engine -->
      <StackPanel Spacing="4">
        <TextBlock Classes="heading" Text="ENGINE" />
        <TextBlock Text="{Binding EngineText}" Classes="secondary" FontSize="{DynamicResource Font.Size.Small}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  </DockPanel>
</UserControl>
