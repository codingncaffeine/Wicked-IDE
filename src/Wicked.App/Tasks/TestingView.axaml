<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="using:Wicked.App.Tasks"
             xmlns:shell="using:Wicked.App.Shell"
             x:Class="Wicked.App.Tasks.TestingView"
             x:DataType="t:TestingViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.tests ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="ListBox.tests ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    </Style>
    <Style Selector="ListBox.tests ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
    </Style>
    <Style Selector="StackPanel.testactions">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.testactions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected StackPanel.testactions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.testlink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="0,0,0,4">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="10,0,8,4">
      <Button Name="TestRunAll" Classes="quiet" Command="{Binding RunAllCommand}" ToolTip.Tip="Run All Tests" Padding="5">
        <shell:Icon Data="{StaticResource Icon.Play}" Size="15" Foreground="{DynamicResource Brush.Success}" />
      </Button>
      <Button Name="TestRunFailed" Classes="quiet" Command="{Binding RunFailedCommand}" ToolTip.Tip="Rerun Failed Tests" Padding="5">
        <shell:Icon Data="{StaticResource Icon.RotateCcw}" Size="15" />
      </Button>
      <Button Name="TestStop" Classes="quiet" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" ToolTip.Tip="Stop" Padding="5">
        <shell:Icon Data="{StaticResource Icon.Square}" Size="15" />
      </Button>
      <Button Name="TestRefresh" Classes="quiet" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh Tests" Padding="5">
        <shell:Icon Data="{StaticResource Icon.RefreshCw}" Size="15" />
      </Button>
    </StackPanel>
    <TextBox DockPanel.Dock="Top" Name="TestFilter" Classes="find" Margin="10,0,8,4" Text="{Binding Filter}" PlaceholderText="Filter (e.g. text)" Padding="6,3,6,3" />
    <TextBlock DockPanel.Dock="Top" Name="TestSummary" Classes="muted" Margin="12,0,8,4" FontSize="{DynamicResource Font.Size.Small}" Text="{Binding Summary}" IsVisible="{Binding !IsEmpty}" TextWrapping="Wrap" />

    <Border DockPanel.Dock="Bottom" Name="TestDetails" IsVisible="{Binding HasDetails}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" MaxHeight="240" Padding="10,6,8,2">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailsTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Details}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="t:TestDetailLine">
                <Panel>
                  <TextBlock Text="{Binding Text}" IsVisible="{Binding IsPlain}" FontFamily="{DynamicResource Font.TestMono}" FontSize="{DynamicResource Font.Size.Small}" />
                  <Button Classes="testlink" HorizontalAlignment="Left" IsVisible="{Binding IsLink}" Command="{Binding $parent[UserControl].((t:TestingViewModel)DataContext).OpenDetailCommand}" CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Font.TestMono}" FontSize="{DynamicResource Font.Size.Small}" TextDecorations="Underline" />
                  </Button>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Panel>
      <TextBlock Name="TestEmpty" Classes="muted" Margin="14,8" TextWrapping="Wrap" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
      <ListBox Name="TestTree" Classes="tests problems" ItemsSource="{Binding Rows}" Background="Transparent" IsVisible="{Binding !IsEmpty}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="t:TestRowItem">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="{Binding Indent}" Height="22">
              <Button Grid.Column="0" Classes="quiet" Padding="2" Width="18" Command="{Binding $parent[UserControl].((t:TestingViewModel)DataContext).ToggleCommand}" CommandParameter="{Binding}" IsVisible="{Binding HasChildren}">
                <Panel>
                  <shell:Icon Data="{StaticResource Icon.ChevronDown}" Size="13" IsVisible="{Binding IsExpanded}" />
                  <shell:Icon Data="{StaticResource Icon.ChevronRight}" Size="13" IsVisible="{Binding !IsExpanded}" />
                </Panel>
              </Button>
              <Panel Grid.Column="1" Width="20" Margin="2,0,4,0" VerticalAlignment="Center">
                <shell:Icon Data="{StaticResource Icon.CircleCheck}" Size="14" Foreground="{DynamicResource Brush.Success}" IsVisible="{Binding IsPassed}" />
                <shell:Icon Data="{StaticResource Icon.CircleX}" Size="14" Foreground="{DynamicResource Brush.Danger}" IsVisible="{Binding IsFailed}" />
                <shell:Icon Data="{StaticResource Icon.RefreshCw}" Size="14" Foreground="{DynamicResource Brush.Accent}" IsVisible="{Binding IsRunning}" />
                <shell:Icon Data="{StaticResource Icon.Minus}" Size="14" Foreground="{DynamicResource Brush.Warning}" IsVisible="{Binding IsSkipped}" />
                <shell:Icon Data="{StaticResource Icon.CircleDot}" Size="14" Foreground="{DynamicResource Brush.Text.Muted}" IsVisible="{Binding IsUnknown}" />
              </Panel>
              <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="{Binding IsProject, Converter={x:Static t:TestingConverters.ProjectWeight}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Tally}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DurationText}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" VerticalAlignment="Center" />
                <StackPanel Classes="testactions" Orientation="Horizontal">
                  <Button Classes="quiet" Padding="3" ToolTip.Tip="Run Test" Command="{Binding $parent[UserControl].((t:TestingViewModel)DataContext).RunOneCommand}" CommandParameter="{Binding}">
                    <shell:Icon Data="{StaticResource Icon.Play}" Size="12" Foreground="{DynamicResource Brush.Success}" />
                  </Button>
                  <Button Classes="quiet" Padding="3" ToolTip.Tip="Go to Test" Command="{Binding $parent[UserControl].((t:TestingViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                    <shell:Icon Data="{StaticResource Icon.FileCode}" Size="12" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
