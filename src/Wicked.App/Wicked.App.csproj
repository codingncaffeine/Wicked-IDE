<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>wicked</AssemblyName>
    <RootNamespace>Wicked.App</RootNamespace>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Server GC collects on every core at once: measured while a 100k-line file highlighted in the background, the
         worst UI-thread pause while scrolling fell from 11-14 ms (workstation GC, gen1) to under 0.5 ms. .NET adapts its
         heap count to the app's size (DATAS), so the memory cost stays small. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wicked.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <!-- The native Wayland backend renders at the monitor's fractional scale. -->
    <PackageReference Include="Avalonia.Wayland" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmToolkitVersion)" />
    <PackageReference Include="Markdig" Version="$(MarkdigVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The editor's JetBrains Mono (SIL OFL 1.1), also set in the chat's code blocks. -->
    <AvaloniaResource Include="..\Wicked.Editor\Fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wicked.Core\Wicked.Core.csproj" />
    <ProjectReference Include="..\Wicked.Editor\Wicked.Editor.csproj" />
  </ItemGroup>

</Project>
