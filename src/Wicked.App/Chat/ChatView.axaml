<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Wicked.App.ViewModels"
             xmlns:shell="using:Wicked.App.Shell"
             xmlns:chat="using:Wicked.App.Chat"
             xmlns:assist="using:Wicked.App.Assistant"
             x:Class="Wicked.App.Chat.ChatView"
             x:DataType="chat:ChatViewModel">
  <DockPanel>
    <!-- ── Header: the conversation's name, its history and a new one. ── -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="14,8,8,4">
      <shell:Icon Data="{StaticResource Icon.Sparkles}" Size="15" Foreground="{DynamicResource Brush.Accent}" />
      <TextBlock Grid.Column="1" Name="ChatTitle" Text="{Binding CurrentTitle}" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="2" Name="HistoryButton" Classes="quiet" Command="{Binding ToggleHistoryCommand}" ToolTip.Tip="Past chats" AutomationProperties.Name="Past chats">
        <shell:Icon Data="{StaticResource Icon.History}" Size="14" />
      </Button>
      <Button Grid.Column="3" Name="NewChatButton" Classes="quiet" Command="{Binding NewChatCommand}" ToolTip.Tip="New chat: a clean context, the old one kept in Past chats (Ctrl+N, or type /clear)" AutomationProperties.Name="New chat">
        <shell:Icon Data="{StaticResource Icon.Plus}" Size="14" />
      </Button>
      <Button Grid.Column="4" Classes="quiet" Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).ToggleAssistantCommand}" ToolTip.Tip="Hide (Ctrl+L)">
        <shell:Icon Data="{StaticResource Icon.X}" Size="14" />
      </Button>
    </Grid>

    <!-- ── The composer, as the AI editors set it: a rounded box at the foot of the panel. ── -->
    <Border DockPanel.Dock="Bottom" Name="ComposerBox" Margin="10" Padding="10,8" CornerRadius="10" DragDrop.AllowDrop="True"
            Background="{DynamicResource Brush.Raised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
      <StackPanel Spacing="6">
        <ItemsControl Name="AttachmentList" ItemsSource="{Binding Attachments}" IsVisible="{Binding Attachments.Count}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="chat:AttachmentViewModel">
              <Grid Width="56" Height="56">
                <Border CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border>
                <Button Classes="quiet" Command="{Binding Remove}" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource Brush.Surface}" ToolTip.Tip="Remove" AutomationProperties.Name="Remove picture">
                  <shell:Icon Data="{StaticResource Icon.X}" Size="10" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The context going with the question, above what is typed (as Cursor and Copilot show it). -->
        <ToggleButton Name="FileChip" Classes="chipbutton" HorizontalAlignment="Left" IsChecked="{Binding IncludeActiveFile}" IsVisible="{Binding HasActiveFile}"
                      ToolTip.Tip="The open file goes with the question (click to leave it out). Mention more with @file:path, @folder:path, @problems, @git or @selection." AutomationProperties.Name="Include the open file">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <shell:Icon Data="{StaticResource Icon.FileText}" Size="12" />
            <TextBlock Text="{Binding ActiveFileName}" FontSize="{DynamicResource Font.Size.Small}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </ToggleButton>

        <TextBox Name="Composer" Classes="composer" Text="{Binding Draft}" PlaceholderText="{Binding ComposerHint}"
                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="170" MinHeight="22" IsEnabled="{Binding HasSelectedModel}" />
        <TextBlock Name="ComposerNote" Text="{Binding ComposerNote}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                   FontSize="{DynamicResource Font.Size.Small}" IsVisible="{Binding ComposerNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
          <!-- The model chip: switches the model, mid-conversation too. -->
          <Button Name="ModelChip" Classes="chipbutton" ToolTip.Tip="Model for this chat" AutomationProperties.Name="Model">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <shell:Icon Data="{StaticResource Icon.Cpu}" Size="12" />
              <TextBlock Name="ModelChipText" Text="{Binding ModelLabel}" FontSize="{DynamicResource Font.Size.Small}" MaxWidth="150" TextTrimming="CharacterEllipsis" />
              <shell:Icon Data="{StaticResource Icon.ChevronDown}" Size="10" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft" ShowMode="Standard">
                <StackPanel Width="280" Spacing="2">
                  <ItemsControl Name="ModelList" ItemsSource="{Binding Models}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="chat:ModelChoice">
                        <Button Classes="menurow" Click="OnMenuRowClick" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Name}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Ellipse Classes="state" Classes.loaded="{Binding IsLoaded}" Classes.loading="{Binding IsLoading}" Classes.failed="{Binding IsFailed}" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding StateText}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <shell:Icon Grid.Column="2" Data="{StaticResource Icon.Check}" Size="13" Foreground="{DynamicResource Brush.Accent}" IsVisible="{Binding IsSelected}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Name="OpenModelsFromChip" Classes="menurow" Click="OnMenuRowClick" Command="{Binding ShowModelsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <shell:Icon Data="{StaticResource Icon.Boxes}" Size="13" />
                      <TextBlock Text="Manage models…" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- The system prompt this chat keeps. -->
          <Button Grid.Column="1" Name="PromptChip" Classes="chipbutton" HorizontalAlignment="Left" ToolTip.Tip="System prompt for this chat" AutomationProperties.Name="System prompt">
            <!-- A grid, not a stack: the label trims when the row is narrow (this chip is the one that gives way). -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
              <shell:Icon Data="{StaticResource Icon.SlidersHorizontal}" Size="12" />
              <TextBlock Grid.Column="1" Name="PromptChipText" Text="{Binding PromptLabel}" FontSize="{DynamicResource Font.Size.Small}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft" ShowMode="Standard" Closed="OnPromptFlyoutClosed">
                <StackPanel Width="320" Spacing="2">
                  <TextBlock Classes="heading" Text="SYSTEM PROMPT FOR THIS CHAT" Margin="4,2,4,4" />
                  <TextBox Name="SystemPromptBox" Text="{Binding SystemPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="220"
                           PlaceholderText="None: the model answers with its own defaults" Margin="0,0,0,8" AutomationProperties.Name="System prompt text" />
                  <TextBlock Classes="heading" Text="PRESETS" Margin="4,2,4,2" />
                  <ItemsControl Name="PromptList" ItemsSource="{Binding PromptChoices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="chat:PromptChoice">
                        <Button Classes="menurow" Click="OnMenuRowClick" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Name}">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <shell:Icon Grid.Column="1" Data="{StaticResource Icon.Check}" Size="13" Foreground="{DynamicResource Brush.Accent}" IsVisible="{Binding IsCurrent}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Name="EditPromptsButton" Classes="menurow" Click="OnMenuRowClick" Command="{Binding EditPromptsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <shell:Icon Data="{StaticResource Icon.Pencil}" Size="13" />
                      <TextBlock Text="Manage presets…" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <ToggleButton Grid.Column="2" Name="AgentToggle" Classes="chipbutton" IsChecked="{Binding AgentMode}" IsVisible="{Binding CanUseAgent}"
                        ToolTip.Tip="Agent: the model may read, search, edit and run commands in the project, asking before it changes anything" AutomationProperties.Name="Agent mode">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <shell:Icon Data="{StaticResource Icon.Wrench}" Size="12" />
              <TextBlock Text="Agent" FontSize="{DynamicResource Font.Size.Small}" />
            </StackPanel>
          </ToggleButton>
          <!-- Pictures: only for a model that can see. -->
          <Button Grid.Column="3" Name="AttachButton" Classes="quiet" Click="OnAttach" IsVisible="{Binding AcceptsImages}"
                  ToolTip.Tip="Attach a picture (or paste or drop one)" AutomationProperties.Name="Attach picture">
            <shell:Icon Data="{StaticResource Icon.Paperclip}" Size="15" />
          </Button>

          <!-- How much of the model's context the conversation fills. -->
          <StackPanel Grid.Column="4" Name="ContextMeter" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" IsVisible="{Binding HasContext}"
                      ToolTip.Tip="{Binding ContextText}">
            <ProgressBar Width="38" MinWidth="0" Height="4" MinHeight="4" Minimum="0" Maximum="1" Value="{Binding ContextFraction}" Classes.high="{Binding ContextHigh}" />
          </StackPanel>

          <Button Grid.Column="5" Name="SendButton" Classes="primary send" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"
                  IsVisible="{Binding IsIdle}" ToolTip.Tip="Send (Enter)" AutomationProperties.Name="Send">
            <shell:Icon Data="{StaticResource Icon.ArrowUp}" Size="15" StrokeWidth="2.2" Foreground="{DynamicResource Brush.Text.OnAccent}" />
          </Button>
          <Button Grid.Column="5" Name="StopButton" Classes="primary send" Command="{Binding StopCommand}" IsVisible="{Binding IsStreaming}"
                  ToolTip.Tip="Stop (Esc)" AutomationProperties.Name="Stop">
            <shell:Icon Data="{StaticResource Icon.Square}" Size="12" StrokeWidth="2.2" Foreground="{DynamicResource Brush.Text.OnAccent}" />
          </Button>
        </Grid>
      </StackPanel>
    </Border>

    <Panel>
      <!-- No model installed: the way to one. -->
      <StackPanel Name="NoModelState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="28,0"
                  IsVisible="{Binding !HasModels}">
        <shell:Icon Data="{StaticResource Icon.Bot}" Size="30" StrokeWidth="1.4" Foreground="{DynamicResource Brush.Text.Muted}" />
        <TextBlock Name="NoModelTitle" Text="{Binding NoModelTitle}" HorizontalAlignment="Center" FontWeight="SemiBold" />
        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                   Name="NoModelText" Text="{Binding NoModelText}" />
        <Button Name="OpenModelsButton" Classes="accent-soft" Command="{Binding ShowModelsCommand}" HorizontalAlignment="Center" Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <shell:Icon Data="{StaticResource Icon.Boxes}" Size="14" />
            <TextBlock Text="Choose a model" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- A model, nothing said yet. -->
      <StackPanel Name="WelcomeState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="28,0">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="HasModels" />
            <Binding Path="IsEmpty" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <shell:Icon Data="{StaticResource Icon.Sparkles}" Size="26" StrokeWidth="1.4" Foreground="{DynamicResource Brush.Accent}" />
        <TextBlock Text="Ask anything" HorizontalAlignment="Center" FontWeight="SemiBold" />
        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" Text="Everything runs on this PC. Enter sends, Shift+Enter starts a new line." />
      </StackPanel>

      <!-- The conversation. A plain stack, not a virtualizing one: a streaming reply taller than the view made the
           virtualizing panel recycle and rebuild a message on nearly every frame (20–90 ms on the UI thread, measured in a
           real window). Each message already redraws only the blocks that changed. -->
      <ItemsControl Name="MessageList" ItemsSource="{Binding Messages}" IsVisible="{Binding !IsEmpty}">
        <ItemsControl.Template>
          <ControlTemplate>
            <ScrollViewer Name="MessageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="chat:ChatMessageViewModel">
            <Border Classes="message" Classes.user="{Binding IsUser}">
              <StackPanel Spacing="6">
                <!-- A user turn -->
                <StackPanel Spacing="6" IsVisible="{Binding IsUser}">
                  <ItemsControl ItemsSource="{Binding Thumbnails}" IsVisible="{Binding HasImages}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,6,6" MaxWidth="150" MaxHeight="110">
                          <Image Source="{Binding}" Stretch="Uniform" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding !IsEditing}" />
                  <StackPanel Spacing="6" IsVisible="{Binding IsEditing}">
                    <TextBox Name="EditBox" Classes="composer" Text="{Binding EditText}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200"
                             Background="{DynamicResource Brush.Surface}" Padding="8,6" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                      <Button Name="CancelEditButton" Classes="secondary small" Content="Cancel" Command="{Binding CancelEditCommand}" />
                      <Button Name="ResendButton" Classes="primary small" Content="Resend" Command="{Binding SaveEditCommand}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <!-- An assistant turn -->
                <StackPanel Spacing="6" IsVisible="{Binding IsAssistant}">
                  <Border Classes="reasoning" IsVisible="{Binding ShowReasoning}">
                    <StackPanel Spacing="4">
                      <Button Name="ThoughtToggle" Classes="quiet small" Command="{Binding ToggleReasoningCommand}" HorizontalAlignment="Left" Padding="4,2"
                              AutomationProperties.Name="{Binding ThoughtLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <shell:Icon Data="{StaticResource Icon.Brain}" Size="13" />
                          <TextBlock Name="ThoughtLabel" Text="{Binding ThoughtLabel}" FontSize="{DynamicResource Font.Size.Small}" />
                          <shell:Icon Data="{StaticResource Icon.ChevronDown}" Size="11" IsVisible="{Binding ReasoningExpanded}" />
                          <shell:Icon Data="{StaticResource Icon.ChevronRight}" Size="11" IsVisible="{Binding !ReasoningExpanded}" />
                        </StackPanel>
                      </Button>
                      <chat:MarkdownView Name="ReasoningView" Blocks="{Binding ReasoningBlocks}" IsVisible="{Binding ReasoningExpanded}" Classes="reasoningtext" />
                    </StackPanel>
                  </Border>
                  <ItemsControl Name="AgentSteps" ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="assist:AgentStep">
                        <Border Classes="agentstep" Classes.failed="{Binding IsFailed}">
                          <StackPanel Spacing="4">
                            <Button Classes="quiet small" Padding="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ToggleDetailCommand}">
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <shell:Icon Data="{Binding Icon, Converter={x:Static assist:IconKey.Instance}}" Size="13" />
                                <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Font.Size.Small}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                <TextBlock Text="…" Classes="muted" IsVisible="{Binding IsRunning}" />
                              </StackPanel>
                            </Button>
                            <SelectableTextBlock Text="{Binding Detail}" Classes="stepdetail" TextWrapping="Wrap" IsVisible="{Binding Expanded}" />
                            <StackPanel Spacing="6" IsVisible="{Binding IsAsking}">
                              <SelectableTextBlock Text="{Binding Detail}" Classes="stepdetail" TextWrapping="Wrap" MaxHeight="180" IsVisible="{Binding HasDetail}" />
                              <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontWeight="SemiBold" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Name="StepAllow" Classes="primary small" Content="Allow" Command="{Binding AllowCommand}" />
                                <Button Name="StepAlways" Classes="secondary small" Content="Always allow" Command="{Binding AlwaysAllowCommand}" />
                                <Button Name="StepDeny" Classes="secondary small" Content="Deny" Command="{Binding DenyCommand}" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Name="WaitingText" Text="{Binding Status}" Classes="muted" IsVisible="{Binding IsWaiting}" />
                  <chat:MarkdownView Name="AnswerView" Blocks="{Binding Blocks}" />
                  <Border Classes="replyerror" IsVisible="{Binding HasError}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <shell:Icon Data="{StaticResource Icon.CircleAlert}" Size="15" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Top" Margin="0,1,0,0" />
                      <TextBlock Name="ErrorText" Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" />
                      <Button Name="RetryButton" Grid.Column="2" Classes="secondary small" Content="Retry" Command="{Binding RetryCommand}" IsVisible="{Binding CanChange}" VerticalAlignment="Top" />
                    </Grid>
                  </Border>
                </StackPanel>

                <!-- Footer: the numbers, then copy, regenerate, edit. -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding ShowActions}">
                  <TextBlock Name="FooterText" Text="{Binding Footer}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Name="CopyMessageButton" Classes="quiet small" Command="{Binding CopyCommand}" ToolTip.Tip="Copy" AutomationProperties.Name="Copy message">
                    <shell:Icon Data="{StaticResource Icon.Copy}" Size="13" />
                  </Button>
                  <Button Grid.Column="2" Name="RegenerateButton" Classes="quiet small" Command="{Binding RegenerateCommand}" IsVisible="{Binding ShowRegenerate}"
                          ToolTip.Tip="Regenerate" AutomationProperties.Name="Regenerate">
                    <shell:Icon Data="{StaticResource Icon.RefreshCw}" Size="13" />
                  </Button>
                  <Button Grid.Column="3" Name="EditMessageButton" Classes="quiet small" Command="{Binding EditCommand}" IsVisible="{Binding ShowEdit}"
                          ToolTip.Tip="Edit and resend" AutomationProperties.Name="Edit message">
                    <shell:Icon Data="{StaticResource Icon.Pencil}" Size="13" />
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Past chats. -->
      <Border Name="HistoryPanel" Background="{DynamicResource Brush.Surface}" IsVisible="{Binding HistoryOpen}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="heading" Text="PAST CHATS" Margin="14,6,14,6" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="Nothing yet. A chat is kept here once it has a reply." Margin="14,4" TextWrapping="Wrap"
                     IsVisible="{Binding !History.Count}" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="HistoryList" ItemsSource="{Binding History}" Margin="6,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="chat:ConversationItem">
                  <Grid ColumnDefinitions="*,Auto,Auto" Classes="historyrow" Classes.current="{Binding IsCurrent}">
                    <Button Name="OpenChat" Classes="historyopen" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding When}" Classes="muted" FontSize="{DynamicResource Font.Size.Small}" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Name="RenameChat" Classes="quiet small" Command="{Binding RenameCommand}" ToolTip.Tip="Rename" AutomationProperties.Name="Rename chat">
                      <shell:Icon Data="{StaticResource Icon.Pencil}" Size="13" />
                    </Button>
                    <Button Grid.Column="2" Name="DeleteChat" Classes="quiet small" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete chat">
                      <shell:Icon Data="{StaticResource Icon.Trash2}" Size="13" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
