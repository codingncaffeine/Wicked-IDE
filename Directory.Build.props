<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Real cultures stay on so the interface can be translated; every parser passes CultureInfo.InvariantCulture itself. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Known-vulnerable dependencies, transitive ones included, fail the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- Unused usings fail the build (IDE0005), which needs the documentation file; undocumented members are allowed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Wicked IDE</Product>
    <Company>Wicked IDE</Company>
    <Authors>codingncaffeine</Authors>
    <Copyright>Copyright (C) 2026 Wicked IDE contributors</Copyright>
    <VersionPrefix>0.0.5</VersionPrefix>
  </PropertyGroup>

  <!-- Central package versions: bump here and nowhere else. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <AvaloniaEditVersion>12.0.0</AvaloniaEditVersion>
    <TextMateSharpVersion>2.0.3</TextMateSharpVersion>
    <!-- BSD-2: the chat view parses model replies with it, on a worker. -->
    <MarkdigVersion>1.2.0</MarkdigVersion>
    <!-- MIT: init.csx, the user's startup script, runs through the C# scripting API. -->
    <RoslynVersion>5.0.0</RoslynVersion>
    <!-- The versions Avalonia itself ships with: one copy of each native library in the app. -->
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
    <HarfBuzzSharpVersion>8.3.1.3</HarfBuzzSharpVersion>
    <SqliteVersion>10.0.9</SqliteVersion>
    <!-- The bundle is pinned past the one Microsoft.Data.Sqlite brings, whose native library has a known advisory. -->
    <SqlitePclVersion>3.0.3</SqlitePclVersion>
    <MvvmToolkitVersion>8.4.2</MvvmToolkitVersion>
    <TimeTestingVersion>10.11.0</TimeTestingVersion>
    <TestSdkVersion>18.10.1</TestSdkVersion>
    <XunitVersion>3.2.2</XunitVersion>
    <XunitRunnerVersion>3.1.5</XunitRunnerVersion>
  </PropertyGroup>

</Project>
