<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 builds its own app host. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Wicked.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(TimeTestingVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Real programs' terminal output, recorded once, that the emulator replays (see Terminal/RecordedOutputTests.cs). -->
  <ItemGroup>
    <None Include="Terminal\Recordings\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Basics\basics.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\Wicked.Core\Wicked.Core.csproj" />
    <!-- The scripted llama-server stand-in the model-runtime tests pack into their fake engine archive. -->
    <ProjectReference Include="..\Wicked.FakeEngine\Wicked.FakeEngine.csproj" />
    <!-- The scripted debug adapter the debugger tests talk to, in process and as a child process. -->
    <ProjectReference Include="..\Wicked.FakeAdapter\Wicked.FakeAdapter.csproj" />
    <ProjectReference Include="..\..\src\Wicked.Editor\Wicked.Editor.csproj" />
    <ProjectReference Include="..\..\src\Wicked.Daemon\Wicked.Daemon.csproj" />
    <ProjectReference Include="..\..\src\Wicked.Cli\Wicked.Cli.csproj" />
    <ProjectReference Include="..\..\src\Wicked.App\Wicked.App.csproj" />
  </ItemGroup>

</Project>
